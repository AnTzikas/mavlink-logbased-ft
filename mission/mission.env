# Supervisor configuration

# COMMAND=python3 /app/missions/simple_patrol/patrol_mission.py
#APP_NAME=patrol_mission.py

COMMAND=python3 /app/missions/complex_survey/mission.py 
APP_NAME=mission.py
MISSION_CONFIG=/app/missions/complex_survey/mission.conf

CHECKPOINT_INTERVAL=60
CHECKPOINT_BASEDIR=/mnt/checkpoints
CHECKPOINT=1

# File Ownership configuration
PUID=1000
PGID=1000

# Patrol Mission configuration
USE_WRAPPER=1
ALT_TARGET=15.0
LAPS_TOTAL=3
BATT_CRIT=60.0
CONN_STR=udpin:0.0.0.0:14551

# Fail injection logic
FAIL_ENABLE=1
FAIL_CONFIG="/app/missions/fail_config.txt"
FAIL_PHASE=AFTER_SEND
FAIL_LAP=1
FAIL_WP=3